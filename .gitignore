.venv/
.venv.invalid.*/
.ansible/
.cache/

.env
blitzecdn.toml

.state/
generated/*.yml
data/*.yml
data/*.db
data/*.db-shm
data/*.db-wal
# Runtime locks a deploy takes. `uv.lock` is not one of them: it is the
# dependency lockfile every install and every CI run builds from, so it has to
# be tracked. Without this exception the broad pattern above silently drops it,
# and `uv sync --frozen` then fails on a checkout that looks complete.
**/*.lock
!uv.lock
log/*.log
*.retry

__pycache__/
*.pyc
dist/
*.egg-info/

.mypy_cache/
.pytest_cache/
.ruff_cache/

.coverage
coverage.xml
htmlcov/

.DS_Store
.codex/
