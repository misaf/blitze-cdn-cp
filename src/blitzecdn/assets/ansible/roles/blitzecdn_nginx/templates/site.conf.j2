# Managed by BlitzeCDN. Local edits are overwritten.
{% set ssl_mode = item.ssl_mode %}
{% set tls = ssl_mode != 'off' %}
{% set origin_host = item.origin_host %}
{% if ':' in origin_host and not origin_host.startswith('[') %}{% set origin_host = '[' ~ origin_host ~ ']' %}{% endif %}
{% set max_upload_size = item.max_upload_size | default('100m') %}
{% set visitor_headers = item.visitor_headers | default({}, true) or {} %}
{% set connecting_ip = visitor_headers.connecting_ip | default(true) %}
{% macro fragments(context, listener_port, visitor_scheme, redirect_https=false, first_hostname=true) %}
{% for resource in blitzecdn_nginx_resources[context] | default([]) %}
{{ lookup('ansible.builtin.template', resource.template, template_vars={'site': item, 'listener_port': listener_port, 'visitor_scheme': visitor_scheme, 'redirect_https': redirect_https, 'default_server': false, 'first_hostname': first_hostname}) }}
{% endfor %}
{% endmacro %}
{#
  Which origin connection a listener proxies to, as "<scheme>:<port>". The one
  place the SSL-mode matrix is spelled: the upstream groups below and the
  proxy_pass that names them both read it, so they cannot disagree about which
  group a listener uses.
#}
{% macro origin_of(listener_port, visitor_scheme) -%}
{%- set secure = visitor_scheme == 'https' -%}
{%- set origin_tls = secure and (ssl_mode in ['full', 'full_strict'] or (ssl_mode == 'flexible' and listener_port != 443)) -%}
{#- Flexible HTTPS/443 terminates at the edge and reaches the HTTP origin on 80. -#}
{%- set origin_port = 80 if secure and ssl_mode == 'flexible' and listener_port == 443 else listener_port -%}
{{ 'https' if origin_tls else 'http' }}:{{ origin_port }}
{%- endmacro %}
{#
  Site names are [a-z0-9-] and the suffix is always "_<scheme>_<port>", so the
  underscores make every group name unique across the whole edge.
#}
{% macro upstream_name(origin) -%}
blitzecdn_origin_{{ item.name }}_{{ origin | replace(':', '_') }}
{%- endmacro %}
{% macro proxy(listener_port, visitor_scheme='http') %}
{% set origin = origin_of(listener_port, visitor_scheme) | string %}
{% set origin_scheme = origin.split(':')[0] %}
{% set secure = visitor_scheme == 'https' %}
        proxy_pass {{ origin_scheme }}://{{ upstream_name(origin) }};
        proxy_http_version 1.1;
        proxy_set_header Host {{ item.origin_request_host | default('$host') }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header BZ-Connecting-IP {{ '$remote_addr' if connecting_ip else '""' }};
        proxy_set_header BZ-IPCountry $blitzecdn_visitor_ip_country;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $blitzecdn_connection_upgrade;
{% if origin_scheme == 'https' %}
        proxy_ssl_server_name on;
        proxy_ssl_name {{ item.origin_sni | default(item.origin_request_host | default(item.origin_host)) }};
        proxy_ssl_verify {{ 'on' if ssl_mode == 'full_strict' else 'off' }};
{% if ssl_mode == 'full_strict' %}
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 5;
{% endif %}
{% endif %}
        proxy_connect_timeout {{ blitzecdn_nginx_proxy_connect_timeout }};
        proxy_read_timeout {{ blitzecdn_nginx_proxy_read_timeout }};
{% if secure and blitzecdn_nginx_hsts_enabled %}
        add_header Strict-Transport-Security "max-age={{ blitzecdn_nginx_hsts_max_age }}" always;
{% endif %}
{% endmacro %}
{% macro reserved_locations() %}
    location = /.blitzecdn/release {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "{{ blitzecdn_release_digest | default('untracked') }}\n";
    }
    location = /.blitzecdn {
        add_header Cache-Control "no-store" always;
        return 404;
    }
    location ^~ /.blitzecdn/ {
        add_header Cache-Control "no-store" always;
        return 404;
    }
{% endmacro %}
{% macro route(listener_port, visitor_scheme, redirect_https=false) %}
    location / {
{{ fragments('access', listener_port, visitor_scheme, redirect_https) }}
        root {{ blitzecdn_edge_runtime.paths.empty }};
        try_files /__blitzecdn_dispatch__ @blitzecdn_upstream;
    }
    location @blitzecdn_upstream {
        set $blitzecdn_visitor_ip_country "";
{{ fragments('upstream', listener_port, visitor_scheme, redirect_https) }}
{% if redirect_https %}
        return 301 https://$host$request_uri;
{% else %}
{{ proxy(listener_port, visitor_scheme) }}
{% endif %}
    }
{% endmacro %}
{# Socket options belong to exactly one server per address:port. #}
{% set backlog_owner = namespace(http='', https='') %}
{% if not blitzecdn_nginx_default_server | bool %}
{% for candidate in blitzecdn_nginx_sites | default([item], true) %}
{% if candidate.enabled | default(true) | bool %}
{% if not backlog_owner.http %}{% set backlog_owner.http = candidate.name %}{% endif %}
{% if candidate.ssl_mode != 'off' and not backlog_owner.https %}{% set backlog_owner.https = candidate.name %}{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{#
  One upstream group per origin connection this site actually proxies to, so
  idle connections to the origin are pooled and reused instead of every cache
  miss paying a TCP handshake, and for an HTTPS origin a TLS handshake as well.
  A literal proxy_pass to host:port, or a variable one, has no pool to return a
  connection to: Nginx closes it when the response ends.

  The group is keyed by origin scheme and port, not by listener, because
  Flexible's 443 and the plain 80 listener reach the same http:80 and must not
  declare it twice. A redirecting HTTP listener proxies nothing and contributes
  no group, and a site with no hostnames renders no servers and so no groups —
  without resolvers a group's name is resolved at load, and a site that serves
  nothing must not be able to fail the edge's configuration test.

  With resolvers the server carries `resolve`, which keeps what the variable
  proxy_pass used to give: the origin's address follows DNS at the resolver's
  `valid` interval rather than being pinned at load, and an origin whose name
  does not resolve yet fails its own requests rather than the reload. `resolve`
  needs its group in shared memory; every group on the edge shares the one zone
  so its size is one fleet-wide setting rather than one per site.

  Keepalive needs the request to the origin to be HTTP/1.1 with an empty
  Connection header. proxy() sets the version, and the
  $blitzecdn_connection_upgrade map in http.conf.j2 sends "" whenever the
  visitor is not upgrading.
#}
{% set origins = namespace(wanted=[]) %}
{% if item.server_names %}
{% if not (tls and (item.always_use_https | default(false))) %}
{% for port in blitzecdn_edge_runtime.listeners.http %}
{% set origin = origin_of(port, 'http') | string %}
{% if origin not in origins.wanted %}{% set origins.wanted = origins.wanted + [origin] %}{% endif %}
{% endfor %}
{% endif %}
{% if tls %}
{% for port in blitzecdn_edge_runtime.listeners.https %}
{% set origin = origin_of(port, 'https') | string %}
{% if origin not in origins.wanted %}{% set origins.wanted = origins.wanted + [origin] %}{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% for origin in origins.wanted %}
upstream {{ upstream_name(origin) }} {
{% if blitzecdn_nginx_resolvers %}
    zone {{ blitzecdn_nginx_upstream_zone }} {{ blitzecdn_nginx_upstream_zone_size }};
    server {{ origin_host }}:{{ origin.split(':')[1] }} resolve;
{% else %}
    server {{ origin_host }}:{{ origin.split(':')[1] }};
{% endif %}
{% if blitzecdn_nginx_upstream_keepalive | int > 0 %}
    keepalive {{ blitzecdn_nginx_upstream_keepalive }};
    keepalive_timeout {{ blitzecdn_nginx_upstream_keepalive_timeout }};
{% endif %}
}
{% endfor %}
{% for hostname in item.server_names %}
{% set first_hostname = loop.first %}
{% set log_name = hostname | replace('*', '_wildcard') %}
{% for port in blitzecdn_edge_runtime.listeners.http %}
server {
    listen {{ port }}{% if first_hostname and item.name == backlog_owner.http %} backlog={{ blitzecdn_nginx_listen_backlog }}{% endif %};
    listen [::]:{{ port }}{% if first_hostname and item.name == backlog_owner.http %} backlog={{ blitzecdn_nginx_listen_backlog }}{% endif %};
    server_name {{ hostname }};
    client_max_body_size {{ max_upload_size }};
    error_log {{ blitzecdn_edge_runtime.paths.logs }}/domains/{{ log_name }}.error.log warn;
    error_log /dev/stderr warn;
{% if blitzecdn_nginx_access_log_enabled | bool %}
    access_log {{ blitzecdn_edge_runtime.paths.logs }}/domains/{{ log_name }}.access.log {{ blitzecdn_nginx_log_format_name }};
{% else %}
    access_log off;
{% endif %}
{{ fragments('server', port, 'http', tls and (item.always_use_https | default(false)), first_hostname) }}
    location ^~ /.well-known/acme-challenge/ {
        root {{ blitzecdn_edge_runtime.paths.acme }};
        default_type text/plain;
        try_files $uri =404;
    }
{{ reserved_locations() }}
{{ route(port, 'http', tls and (item.always_use_https | default(false))) }}
}
{% endfor %}
{% if tls %}
{% for port in blitzecdn_edge_runtime.listeners.https %}
server {
    listen {{ port }} ssl{% if first_hostname and item.name == backlog_owner.https %} backlog={{ blitzecdn_nginx_listen_backlog }}{% endif %};
    listen [::]:{{ port }} ssl{% if first_hostname and item.name == backlog_owner.https %} backlog={{ blitzecdn_nginx_listen_backlog }}{% endif %};
    http2 on;
    server_name {{ hostname }};
    client_max_body_size {{ max_upload_size }};
    error_log {{ blitzecdn_edge_runtime.paths.logs }}/domains/{{ log_name }}.error.log warn;
    error_log /dev/stderr warn;
{% if blitzecdn_nginx_access_log_enabled | bool %}
    access_log {{ blitzecdn_edge_runtime.paths.logs }}/domains/{{ log_name }}.access.log {{ blitzecdn_nginx_log_format_name }};
{% else %}
    access_log off;
{% endif %}
{{ fragments('server', port, 'https', first_hostname=first_hostname) }}
    ssl_certificate {{ item.certificate_path }};
    ssl_certificate_key {{ item.certificate_key_path }};
{% if item.minimum_tls_version | default('1.2') == '1.3' %}
    ssl_protocols TLSv1.3;
{% else %}
    ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}
    ssl_ciphers {{ blitzecdn_nginx_ssl_ciphers }};
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
{% if blitzecdn_nginx_ssl_stapling | bool and blitzecdn_nginx_resolvers %}
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate {{ item.certificate_path }};
{% endif %}
    location ^~ /.well-known/acme-challenge/ {
        root {{ blitzecdn_edge_runtime.paths.acme }};
        default_type text/plain;
        try_files $uri =404;
    }
{{ reserved_locations() }}
{{ route(port, 'https') }}
}
{% endfor %}
{% endif %}
{% endfor %}
