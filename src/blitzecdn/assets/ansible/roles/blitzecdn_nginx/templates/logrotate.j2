# Managed by BlitzeCDN. Local edits are overwritten.
# The global error log takes startup errors and those raised before Nginx has
# selected a hostname; it lives in the same mount and needs the same bound.
{{ blitzecdn_edge_runtime.paths.logs }}/error.log
{{ blitzecdn_edge_runtime.paths.logs }}/domains/*.log {
    daily
    maxsize 100M
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    su root adm
    # Inherit numeric ownership from the existing file; the worker is container-only.
    create 0640
    sharedscripts
    postrotate
        if [ "$(/usr/bin/docker inspect --format '{{ '{{.State.Running}}' }}' {{ blitzecdn_edge_runtime.container | quote }} 2>/dev/null)" = true ]; then
            # Signal the master directly, without parsing the image's default config.
            /usr/bin/docker exec {{ blitzecdn_edge_runtime.container | quote }} sh -c 'kill -USR1 "$(cat /var/run/nginx.pid)"'
        fi
    endscript
}
