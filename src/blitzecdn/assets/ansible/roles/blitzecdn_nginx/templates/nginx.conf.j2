# Managed release {{ blitzecdn_release_digest }}. All includes name this tree,
# so an old worker's executable resources remain available during a reload.
include {{ blitzecdn_edge_runtime.paths.modules_conf }};
user nginx;
worker_processes auto;
worker_rlimit_nofile {{ blitzecdn_edge_runtime.nofile }};
error_log {{ blitzecdn_edge_runtime.paths.logs }}/error.log warn;
pid /var/run/nginx.pid;
events {
    worker_connections {{ blitzecdn_nginx_worker_connections }};
}
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Keep the nginx version out of the Server header and built-in error pages,
    # so a scanner cannot match the edge against a version's CVEs.
    server_tokens off;
    sendfile on;
    # With sendfile, send the response headers and the start of the body in one
    # full packet rather than a header-only one first. tcp_nodelay is Nginx's
    # default and is stated because the pair is what makes tcp_nopush safe: the
    # last partial packet of a response is pushed immediately, not held for the
    # 200ms Nagle would wait.
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ blitzecdn_nginx_keepalive_timeout }};
    keepalive_requests {{ blitzecdn_nginx_keepalive_requests }};
    # Visitor-side limits for every server on the edge, the first line of
    # defence before a request reaches a cache or an origin. The timeouts close
    # slowloris and slow-POST clients; see the role defaults.
    client_header_timeout {{ blitzecdn_nginx_client_header_timeout }};
    client_body_timeout {{ blitzecdn_nginx_client_body_timeout }};
    send_timeout {{ blitzecdn_nginx_send_timeout }};
    large_client_header_buffers {{ blitzecdn_nginx_large_client_header_buffers }};
{% if blitzecdn_nginx_limit_conn_per_ip | int > 0 %}
    limit_conn_zone $binary_remote_addr zone=blitzecdn_conn_per_ip:{{ blitzecdn_nginx_limit_conn_zone_size }};
    limit_conn blitzecdn_conn_per_ip {{ blitzecdn_nginx_limit_conn_per_ip }};
    limit_conn_status 429;
    limit_conn_log_level warn;
{% endif %}
    include {{ blitzecdn_edge_runtime.paths.nginx }}/conf.d/*.conf;
    include {{ blitzecdn_edge_runtime.paths.nginx }}/sites-enabled/*;
}
