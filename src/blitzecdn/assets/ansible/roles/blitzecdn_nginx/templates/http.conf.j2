# Managed by BlitzeCDN.
map $http_upgrade $blitzecdn_connection_upgrade {
    default upgrade;
    ''      '';
}
{% if blitzecdn_nginx_resolvers %}
resolver {{ blitzecdn_nginx_resolvers | join(' ') }} valid={{ blitzecdn_nginx_resolver_valid }};
resolver_timeout {{ blitzecdn_nginx_resolver_timeout }};
{% endif %}
{% if blitzecdn_nginx_access_log_enabled | bool %}
# Hostname files are JSON Lines, read by traffic accounting and cache stats.
# They are the only request log: no aggregate file and no Docker stdout copy.
log_format {{ blitzecdn_nginx_log_format_name }} escape=json
    '{"schema_version":1,"request_id":"$request_id","timestamp":"$time_iso8601",'
    '"hostname":"$host","server_name":"$server_name",'
    '"bytes_sent":$bytes_sent,"body_bytes_sent":$body_bytes_sent,'
    '"status":$status,"request_time":$request_time,'
    '"client_ip":"$remote_addr","request":"$request",'
    '"cache_status":"$sent_http_x_cache_status",'
    '"upstream_address":"$upstream_addr","upstream_response_time":"$upstream_response_time",'
    '"referer":"$http_referer","user_agent":"$http_user_agent"}';
{% endif %}
