# Created by BlitzeCDN on first installation. Later runs preserve credentials;
# edit them by hand and restart the Compose services after a change.
#
# Read by Docker Compose, so every line must stay a plain NAME=value assignment.
#
# A capability's own settings are not seeded here. A capability that
# needs a credential documents its `BLITZE_*` name in its own README and
# declares it; the control plane refuses a `BLITZE_*` name nothing declares,
# and forwards into the Ansible environment only the ones a capability claimed,
# for that capability's role to read. Nothing else here — the API keys below
# least of all — reaches a play.
BLITZE_API_KEYS=operator:{{ blitzecdn_controlplane_api_key }}

# Empty keeps the API on loopback. Set trusted public IPv4 addresses or CIDRs to
# enable access, then recreate blitzecdn-api. This is also where the installer
# reads the ufw rules for the API port from, so the addresses admitted at the
# packet and the addresses admitted by the application cannot drift apart.
{% if blitzecdn_controlplane_allowed_ips %}
BLITZE_ALLOWED_IPS={{ blitzecdn_controlplane_allowed_ips }}
{% else %}
# BLITZE_ALLOWED_IPS=203.0.113.8/32,198.51.100.0/24
{% endif %}
