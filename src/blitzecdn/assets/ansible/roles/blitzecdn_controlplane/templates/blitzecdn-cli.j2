#!/usr/bin/env bash
# Managed by BlitzeCDN. Application commands run in disposable containers.
set -Eeuo pipefail
if [[ ${EUID} -ne 0 ]]; then
  exec sudo --preserve-env=BLITZE_ALLOW_EMPTY_SITES -- "$0" "$@"
fi
exec {{ (blitzecdn_controlplane_install_dir ~ '/.venv/bin/python') | quote }} \
  {{ (blitzecdn_controlplane_config_dir ~ '/host_runtime.py') | quote }} \
  --services {{ blitzecdn_controlplane_compose_file | quote }} -- "$@"
