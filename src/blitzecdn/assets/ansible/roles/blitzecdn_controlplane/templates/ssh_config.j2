# Managed by BlitzeCDN (blitzecdn_controlplane). Manual edits are lost.
Host localhost 127.0.0.1
    # Paths inside the container, matching the Compose state mount.
    IdentityFile /opt/blitzecdn/.state/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    # Rewritten by the role on every converge.
    UserKnownHostsFile /opt/blitzecdn/.state/.ssh/known_hosts.loopback

# Every edge. Keys are enrolled by `blitzecdn edge add` and `edge host-key`,
# never by a converge, so an update keeps them. No trust on first use.
Host *
    StrictHostKeyChecking yes
    UserKnownHostsFile /opt/blitzecdn/.state/.ssh/known_hosts
