# Managed by BlitzeCDN (blitzecdn_controlplane). Non-secret service configuration.
# All capability settings are owned by the single application.
[blitzecdn]

database_path = ".state/control-plane.db"
environment_path = {{ (blitzecdn_controlplane_config_dir ~ '/blitzecdn.env') | to_json }}

deployment_timeout_seconds = 900
preflight_dns_timeout_seconds = 5
origin_check_timeout_seconds = 5
drift_check_interval_seconds = {{ blitzecdn_controlplane_drift_check_seconds }}
api_worker_threads = 2

output_limit_bytes = 1048576
run_log_retention = 500
history_retention = 1000
allow_empty_sites = false
preflight_dns_servers = {{ blitzecdn_controlplane_preflight_dns_servers.split(',') | map('trim') | list | to_json }}

# Backup
backup_dir = {{ blitzecdn_controlplane_backup_dir | to_json }}

# Managed TLS
acme_default_email = {{ blitzecdn_controlplane_effective_acme_email | to_json }}
ssl_automatic_scan_interval_seconds = {{ blitzecdn_controlplane_ssl_automatic_scan_seconds }}
certificate_reconcile_interval_seconds = {{ blitzecdn_controlplane_certificate_reconcile_seconds }}
certificate_renewal_interval_seconds = {{ blitzecdn_controlplane_certificate_renewal_seconds }}
certificate_renewal_budget_seconds = 300
