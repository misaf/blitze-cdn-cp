# Managed by BlitzeCDN. Local edits are overwritten.
# Design notes: docs/design/edge-container.md
name: {{ blitzecdn_edge_stack_project }}

services:
  edge:
    container_name: {{ blitzecdn_edge_runtime.container }}
    image: {{ blitzecdn_edge_stack_resolved_image }}
    command: [nginx, -g, "daemon off;", -c, "{{ blitzecdn_config_release_root }}/current/nginx.conf"]
    # Host networking so $remote_addr is the visitor's address.
    network_mode: host
    ulimits:
      nofile:
        soft: {{ blitzecdn_edge_runtime.nofile }}
        hard: {{ blitzecdn_edge_runtime.nofile }}
    restart: unless-stopped
    # Reaps the zombies an Nginx master would otherwise leave behind as PID 1.
    init: true
    # The master still drops to the image's `nginx` user (worker_uid).
    security_opt:
      - no-new-privileges:true
    stop_grace_period: {{ blitzecdn_edge_stack_stop_grace_period }}
    # Graceful shutdown; SIGTERM drops in-flight requests.
    stop_signal: SIGQUIT
    environment:
      TZ: "{{ blitzecdn_base_timezone | default('UTC') }}"
    volumes:
      # Read-only except cache and logs. Releases mount as one parent so the
      # `current` link swap is visible.
      - {{ blitzecdn_config_release_root }}:{{ blitzecdn_config_release_root }}:ro
      - {{ blitzecdn_edge_runtime.paths.tls }}:{{ blitzecdn_edge_runtime.paths.tls }}:ro
      - {{ blitzecdn_edge_runtime.paths.acme }}:{{ blitzecdn_edge_runtime.paths.acme }}:ro
      - {{ blitzecdn_edge_runtime.paths.empty }}:{{ blitzecdn_edge_runtime.paths.empty }}:ro
      - {{ blitzecdn_edge_runtime.paths.data }}:{{ blitzecdn_edge_runtime.paths.data }}:ro
      - {{ blitzecdn_edge_runtime.paths.secrets }}:{{ blitzecdn_edge_runtime.paths.secrets }}:ro
      # The only writable mounts; both outlive the container.
      - {{ blitzecdn_edge_runtime.paths.cache }}:{{ blitzecdn_edge_runtime.paths.cache }}:rw
      - {{ blitzecdn_edge_runtime.paths.logs }}:{{ blitzecdn_edge_runtime.paths.logs }}:rw
    # Container stdout/stderr only, bounded independently of daemon.json.
    logging:
      driver: json-file
      options:
        max-size: "32m"
        max-file: "3"
    # Marks the container unhealthy; it does not restart it.
    healthcheck:
      test:
        - CMD
        - curl
        - --fail
        - --silent
        - --show-error
        - --max-time
        - "3"
        - --output
        - /dev/null
        - "http://{{ blitzecdn_edge_runtime.status.address }}:{{ blitzecdn_edge_runtime.status.port }}{{ blitzecdn_edge_runtime.status.path }}"
      interval: 30s
      timeout: 5s
      start_period: 20s
      retries: 3

