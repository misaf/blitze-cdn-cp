{#
  Only the 5xx a site has pages for are intercepted: proxy_intercept_errors
  replaces exactly the statuses this location has an error_page for, so an
  origin's 404, 403 or 429 still reaches the visitor as the origin sent it.
  Repeated from error-pages-server.conf.j2 because a location that sets any
  error_page of its own (Under Attack Mode does) inherits none.
#}
{% set pages = site.error_pages | default({}, true) or {} %}
{% set statuses = namespace(items=[]) %}
{% for status in pages | sort %}
{% if status in ['500', '502', '503', '504'] %}
{% set statuses.items = statuses.items + [status] %}
{% endif %}
{% endfor %}
{% if statuses.items and not redirect_https %}
        proxy_intercept_errors on;
{% for status in statuses.items %}
        error_page {{ status }} /.blitzecdn/internal/error-pages/{{ status }}.html;
{% endfor %}
{% endif %}
