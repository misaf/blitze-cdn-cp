{% if blitzecdn_security_under_attack_enabled | bool %}
js_import blitzecdn_under_attack from {{ blitzecdn_security_under_attack_js_file }};
include {{ blitzecdn_security_under_attack_key_file }};
js_var $blitzecdn_under_attack_location;
limit_req_zone $binary_remote_addr zone=blitzecdn_under_attack_verify:10m rate=30r/m;
{% endif %}
{#
  One geo per site with allow_sources: 1 for a client the site's firewall
  exempts from its country and method rules, 0 for everyone else. Site names
  are [a-z0-9-], so swapping '-' for '_' keeps every variable name distinct.
  security-access.conf.j2 reads it under the same condition.
#}
{% for firewalled in blitzecdn_nginx_sites | default([], true) %}
{% set firewall = firewalled.firewall | default({}, true) or {} %}
{% if firewall.allow_sources | default([], true) %}
geo $blitzecdn_firewall_exempt_{{ firewalled.name | replace('-', '_') }} {
    default 0;
{% for source in firewall.allow_sources %}
    {{ source }} 1;
{% endfor %}
}
{% endif %}
{% endfor %}
{#
  One zone per site with a rate limit, keyed by a per-site map rather than by
  $binary_remote_addr directly: the map yields "" — which limit_req neither
  counts nor limits — for a client the site's allow_sources exempt and for a
  URI outside the limited paths, so neither needs an `if` in `location /`.
  Each zone is the same fleet-wide size and the security role caps how many
  sites may declare one, so the shared memory an edge reserves is bounded.
  security-access.conf.j2 names the zone under the same condition.
#}
{% for limited in blitzecdn_nginx_sites | default([], true) %}
{% set rate_limit = limited.rate_limit | default({}, true) or {} %}
{% if rate_limit.requests | default(0) | int > 0 %}
{% set suffix = limited.name | replace('-', '_') %}
{% set exempt = '$blitzecdn_firewall_exempt_' ~ suffix if (limited.firewall | default({}, true) or {}).allow_sources | default([], true) else '0' %}
{% set patterns = namespace(items=[]) %}
{% for path in rate_limit.paths | default([], true) %}
{% set patterns.items = patterns.items + [path | regex_escape] %}
{% endfor %}
map "{{ exempt }}:$uri" $blitzecdn_rate_limit_key_{{ suffix }} {
    default "";
    "~{{ '*' if rate_limit.case_insensitive_paths | default(false) else '' }}^0:{{ '(?:' ~ (patterns.items | join('|')) ~ ')' if patterns.items else '' }}" $binary_remote_addr;
}
limit_req_zone $blitzecdn_rate_limit_key_{{ suffix }} zone=blitzecdn_rate_limit_{{ suffix }}:{{ blitzecdn_security_rate_limit_zone_size }} rate={{ rate_limit.requests | int }}r/{{ 'm' if rate_limit.per | default('second') == 'minute' else 's' }};
{% endif %}
{% endfor %}
