{% if site.cache_enabled | default(true) %}
{% set cache_uri = '$blitzecdn_uri_without_query' if site.cache_query_string_mode | default('include') == 'ignore' else '$request_uri' %}
        proxy_cache {{ blitzecdn_cache_config_zone }};
{# Bypass and no_cache name the same conditions; either alone leaks. See
   docs/design/cache.md#what-is-never-cached. #}
{% set level = site.cache_level | default('standard') %}
{% set cookie_bypass = level == 'standard' or (site.cache_bypass_cookies | default([], true)) %}
{# A path rule reads its own scope's map. #}
{% set cookie_variable = (' $blitzecdn_cache_cookie_' ~ ((site.variable_scope | default(site.name)) | replace('-', '_'))) if cookie_bypass else '' %}
        proxy_cache_bypass $http_upgrade $http_authorization{{ cookie_variable }};
        proxy_no_cache $http_upgrade $http_authorization{{ cookie_variable }}{{ ' $blitzecdn_cache_standard_skip' if level == 'standard' else '' }};
{# $server_port is load-bearing. See docs/design/cache.md#cache-key. #}
        proxy_cache_key "$scheme$server_port$request_method$host{{ cache_uri }}$blitzecdn_accept_encoding";
        proxy_cache_valid 200 301 302 {{ site.cache_valid_success | default('10m') }};
        proxy_cache_valid 404 {{ site.cache_valid_not_found | default('1m') }};
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
{# A 304 need not carry Content-Type, so type entries disable revalidation.
   See docs/design/cache.md#revalidation. #}
{% set type_rules = namespace(found=false) %}
{% for entry in (site.cache_ttl_overrides | default({}, true) | list) + (site.cache_ignore_origin_headers | default([], true) | list) %}
{% if not entry.startswith('.') %}{% set type_rules.found = true %}{% endif %}
{% endfor %}
        proxy_cache_revalidate {{ 'off' if type_rules.found else 'on' }};
{# Hidden from visitors, still stored for blitzecdn_cache_purge. #}
        proxy_hide_header Cache-Tag;
{# The key names the encoding; skip when compression already sends the header. #}
{% set compression_installed = 'compression' in (blitzecdn_nginx_resources.upstream | default([]) | map(attribute='feature')) %}
{% if not (compression_installed and site.compression | default('brotli') != 'off') %}
        proxy_set_header Accept-Encoding $blitzecdn_accept_encoding;
{% endif %}
        add_header X-Cache-Status $upstream_cache_status always;
{% endif %}
