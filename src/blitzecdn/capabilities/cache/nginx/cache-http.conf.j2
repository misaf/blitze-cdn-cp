proxy_cache_path {{ blitzecdn_edge_runtime.paths.cache }}
    levels=1:2
    keys_zone={{ blitzecdn_cache_config_zone }}:{{ blitzecdn_cache_config_size }}
    max_size={{ blitzecdn_cache_config_max_size }}
    inactive={{ blitzecdn_cache_config_inactive }}
    use_temp_path=off;

map $request_uri $blitzecdn_uri_without_query {
    ~^([^?]*) $1;
}
{#
  The `standard` cache level (CacheLevel.STANDARD).

  A request for a static file is 1 here, judged by the path's extension
  before the origin answers: it is what lets a static URL be cached even
  when the visitor carries a session cookie, since browsers send cookies
  with every image and stylesheet they fetch.
#}
map $uri $blitzecdn_cache_static_uri {
    default 0;
    "~*\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|bmp|tiff?|woff2?|ttf|otf|eot|mp4|webm|m4v|mov|mp3|m4a|ogg|oga|wav|flac|pdf|zip|gz|tgz|bz2|xz|7z|rar|tar|wasm)$" 1;
}
{#
  1 when a `standard` site must not store the response: neither the path nor
  the Content-Type is a static file type, and the origin sent none of the
  headers that give an entry its lifetime. Without any of them nginx would
  fall back to proxy_cache_valid and store an HTML page for its full TTL,
  which is the leak `standard` exists to close.

  `volatile` because it reads the origin's response headers: only
  proxy_no_cache, which nginx evaluates once the response is in, may read it,
  and a value cached from an earlier evaluation would predate the response.
#}
map "$blitzecdn_cache_static_uri:$upstream_http_content_type:$upstream_http_cache_control$upstream_http_expires$upstream_http_x_accel_expires" $blitzecdn_cache_standard_skip {
    volatile;
    default 1;
    "~^1:" 0;
    "~*^0:(?:image|font|audio|video)/" 0;
    "~*^0:(?:text/css|text/javascript|application/javascript|application/wasm|application/pdf|application/zip|application/gzip|application/font-woff2?)\s*(?:;[^:]*)?:" 0;
    "~^0:[^:]*:." 0;
}
{#
  One map per site whose cookies keep a request away from the cache: 1 when
  the request carries a bypass cookie. Under `standard` a static file URL is
  exempt (the `0:` prefix), and no listed cookie means any cookie at all.
  Under `everything` only listed cookies count, on every URL.

  The condition is the one cache-upstream.conf.j2 reads the variable under;
  the two must agree, or a site names a variable that was never declared and
  the edge refuses its configuration.
#}
{#
  A path rule's location is a scope of its own: the host's settings with the
  rule's merged in, under the location's variable_scope. Its map is declared
  here beside its host's for the same reason.
#}
{% macro cookie_map(cached, scope) %}
{% set level = cached.cache_level | default('standard') %}
{% set cookies = cached.cache_bypass_cookies | default([], true) %}
{% if cached.cache_enabled | default(true) and (level == 'standard' or cookies) %}
{% set names = namespace(items=[]) %}
{% for cookie in cookies %}
{% set names.items = names.items + [(cookie | regex_escape) | replace('\\*', '[^=;]*')] %}
{% endfor %}
map "$blitzecdn_cache_static_uri:$http_cookie" $blitzecdn_cache_cookie_{{ scope | replace('-', '_') }} {
    default 0;
{% if names.items %}
    "~^{{ '0' if level == 'standard' else '[01]' }}:(?:.*;\s*)?(?:{{ names.items | join('|') }})=" 1;
{% else %}
    "~^0:." 1;
{% endif %}
}
{% endif %}
{% endmacro %}
{% for cached in blitzecdn_nginx_sites | default([], true) %}
{{ cookie_map(cached, cached.name) }}
{% for location in cached.locations | default([], true) %}
{% if not location.redirect %}
{{ cookie_map(cached | combine(location.settings), location.variable_scope) }}
{% endif %}
{% endfor %}
{% endfor %}
{#
  Edge TTL overrides and ignored origin headers, read in the origin hop by
  cache-origin.conf.j2. Every map here reads the origin's response, so all are
  volatile and only read from add_header, once the response is in.

  1 when the origin gave the response a lifetime of its own. The same three
  headers `standard` asks about: an override is the TTL for what the origin
  said nothing about, and a type whose headers are ignored is the exception.
#}
map "$upstream_http_cache_control$upstream_http_expires$upstream_http_x_accel_expires" $blitzecdn_cache_origin_lifetime {
    volatile;
    default 1;
    "" 0;
}
{% macro seconds(duration) -%}
{%- set duration = duration | string -%}
{%- if duration.endswith('ms') -%}
{{ (duration[:-2] | int) // 1000 }}
{%- elif duration[-1:] in ['s', 'm', 'h', 'd', 'w'] -%}
{{ (duration[:-1] | int) * {'s': 1, 'm': 60, 'h': 3600, 'd': 86400, 'w': 604800}[duration[-1:]] }}
{%- else -%}
{{ duration | int }}
{%- endif -%}
{%- endmacro %}
{#
  An entry names a URL extension, a content type or a type family, matched
  against "<Content-Type>|<path>": the extension against the end of the path,
  a type against the start, before any parameters. Rendered extensions first,
  then exact types, then families, and nginx takes the first regex that
  matches, so the more specific entry wins.
#}
{% macro content_patterns(entries) -%}
{%- set ranked = namespace(extensions=[], types=[], families=[]) -%}
{%- for entry in entries -%}
{%- if entry.startswith('.') -%}{%- set ranked.extensions = ranked.extensions + [entry] -%}
{%- elif entry.endswith('/*') -%}{%- set ranked.families = ranked.families + [entry] -%}
{%- else -%}{%- set ranked.types = ranked.types + [entry] -%}
{%- endif -%}
{%- endfor -%}
{%- for entry in ranked.extensions + ranked.types + ranked.families -%}
{%- if entry.startswith('.') -%}
{{ entry }}	\.{{ entry[1:] | regex_escape }}$
{% elif entry.endswith('/*') -%}
{{ entry }}	^{{ entry[:-1] | regex_escape }}
{% else -%}
{{ entry }}	^{{ entry | regex_escape }}\s*(?:;[^|]*)?\|
{% endif -%}
{%- endfor -%}
{%- endmacro %}
{% for cached in blitzecdn_nginx_sites | default([], true) %}
{% set overrides = cached.cache_ttl_overrides | default({}, true) %}
{% set ignored = cached.cache_ignore_origin_headers | default([], true) %}
{% if cached.cache_enabled | default(true) and (overrides or ignored) %}
{% set suffix = cached.name | replace('-', '_') %}
{% if overrides %}
map "$upstream_http_content_type|$uri" $blitzecdn_cache_ttl_{{ suffix }} {
    volatile;
    default "";
{% for line in content_patterns(overrides | list).splitlines() if line %}
{% set entry, pattern = line.split('\t') %}
    "~*{{ pattern }}" {{ seconds(overrides[entry]) }};
{% endfor %}
}
{% endif %}
{% if ignored %}
map "$upstream_http_content_type|$uri" $blitzecdn_cache_ignore_{{ suffix }} {
    volatile;
    default 0;
{% for line in content_patterns(ignored | list).splitlines() if line %}
    "~*{{ line.split('\t')[1] }}" 1;
{% endfor %}
}
{% endif %}
{#
  What the hop sends as X-Accel-Expires, from "<status>:<ignored>:<origin
  set a lifetime>:<override>". An override counts for the statuses
  proxy_cache_valid gives cache_valid_success, and 304 so a revalidation
  renews the entry for as long as a fresh fetch would; 404 keeps
  cache_valid_not_found. An ignored type is stored for its override, else for
  the site's durations, and any other status of it not at all, since the
  origin's word on that is what is being ignored. Anything else passes the
  origin's own X-Accel-Expires through.
#}
map "$status:{{ ('$blitzecdn_cache_ignore_' ~ suffix) if ignored else '0' }}:$blitzecdn_cache_origin_lifetime:{{ ('$blitzecdn_cache_ttl_' ~ suffix) if overrides else '' }}" $blitzecdn_cache_expires_{{ suffix }} {
    volatile;
    default $upstream_http_x_accel_expires;
{% if overrides %}
    "~^(?:200|301|302|304):0:0:(\d+)$" $1;
{% endif %}
{% if ignored %}
{% if overrides %}
    "~^(?:200|301|302|304):1:[01]:(\d+)$" $1;
{% endif %}
    "~^(?:200|301|302|304):1:" {{ seconds(cached.cache_valid_success | default('10m')) }};
    "~^404:1:" {{ seconds(cached.cache_valid_not_found | default('1m')) }};
    "~^\d+:1:" 0;
{% endif %}
}
{% endif %}
{% endfor %}
