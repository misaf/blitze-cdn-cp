# Managed by BlitzeCDN. Local edits are overwritten.
server {
{% for port in blitzecdn_edge_runtime.listeners.http %}
    listen {{ port }} default_server;
    listen [::]:{{ port }} default_server;
{% endfor %}
    server_name _;
    location ^~ /.well-known/acme-challenge/ {
        root {{ blitzecdn_edge_runtime.paths.acme }};
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 444; }
}

server {
{% for port in blitzecdn_edge_runtime.listeners.https %}
    listen {{ port }} ssl default_server;
    listen [::]:{{ port }} ssl default_server;
{% endfor %}
{% for resource in blitzecdn_nginx_resources.server | default([]) %}
{{ lookup('ansible.builtin.template', resource.template, template_vars={'site': {}, 'listener_port': 443, 'visitor_scheme': 'https', 'redirect_https': false, 'default_server': true}) }}
{% endfor %}
    server_name _;
    ssl_reject_handshake on;
}
