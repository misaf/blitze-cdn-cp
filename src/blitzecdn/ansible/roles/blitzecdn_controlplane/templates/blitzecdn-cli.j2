#!/usr/bin/env bash
# Managed by BlitzeCDN (blitzecdn_controlplane). Manual edits are lost.
# One-off commands run in a disposable container. Persistent processes are
# started and stopped only through their Compose services.
set -Eeuo pipefail

if [[ ${EUID} -ne 0 ]]; then
  exec sudo --preserve-env=BLITZE_ALLOW_EMPTY_SITES -- "$0" "$@"
fi

readonly compose_file={{ blitzecdn_controlplane_compose_file | quote }}
compose=(docker compose --file "${compose_file}")
run=("${compose[@]}" run --rm)

if [[ -n ${BLITZE_ALLOW_EMPTY_SITES-} ]]; then
  run+=(-e "BLITZE_ALLOW_EMPTY_SITES=${BLITZE_ALLOW_EMPTY_SITES}")
fi

# Stage root-owned configuration in a directory the unprivileged container
# can replace files in. Individual bind mounts cannot be atomically replaced.
backup_stage=""
cleanup_backup() {
  if [[ -n ${backup_stage} ]]; then
    rm -rf -- "${backup_stage}"
  fi
}
publish_configuration() {
  local source target temporary
  for source in blitzecdn.toml blitzecdn.env; do
    if [[ ${source} == blitzecdn.toml ]]; then
      target={{ (blitzecdn_controlplane_install_dir ~ '/blitzecdn.toml') | quote }}
    else
      target={{ (blitzecdn_controlplane_config_dir ~ '/blitzecdn.env') | quote }}
    fi
    # Database-only restores must not replace configuration or its inode.
    if ! cmp -s "${backup_stage}/${source}" "${target}"; then
      temporary=$(mktemp "${target}.restore.XXXXXX")
      if ! install -o root -g root -m 0600 "${backup_stage}/${source}" "${temporary}"; then
        rm -f -- "${temporary}"
        return 1
      fi
      if [[ ${source} == blitzecdn.toml ]]; then
        chmod 0644 "${temporary}"
      fi
      mv -f -- "${temporary}" "${target}"
    fi
  done
}
if [[ ${1-} == backup ]]; then
  backup_stage=$(mktemp -d)
  trap cleanup_backup EXIT
  install -m 0600 {{ (blitzecdn_controlplane_install_dir ~ '/blitzecdn.toml') | quote }} "${backup_stage}/blitzecdn.toml"
  install -m 0600 {{ (blitzecdn_controlplane_config_dir ~ '/blitzecdn.env') | quote }} "${backup_stage}/blitzecdn.env"
  mkdir "${backup_stage}/.state"
  chown -R 65534:65534 "${backup_stage}"
  run+=(--volume "${backup_stage}:/run/blitzecdn-backup"
    --volume {{ (blitzecdn_controlplane_state_dir ~ ':/run/blitzecdn-backup/.state') | quote }}
    -e BLITZE_PROJECT_DIR=/run/blitzecdn-backup
    -e BLITZE_CONFIG=/run/blitzecdn-backup/blitzecdn.toml
    -e BLITZE_ENVIRONMENT_PATH=/run/blitzecdn-backup/blitzecdn.env)
fi

# A database restore must run with every process that can hold the database
# stopped. Preserve the operator's prior running set and restore it on failure.
if [[ ${1-} == backup && ${2-} == restore ]]; then
  running=()
  services=$("${compose[@]}" ps --status running --services)
  while IFS= read -r service; do
    case "${service}" in
      blitzecdn-api|blitzecdn-worker) running+=("${service}") ;;
    esac
  done <<< "${services}"

  # shellcheck disable=SC2329 # Invoked by the EXIT trap.
  restore_running() {
    local status=$?
    if [[ -n ${running[0]+x} ]]; then
      # Recreate to refresh file bind mounts after atomic config replacement.
      # `--wait`, because `up --detach` returns once the containers have been
      # created and says nothing about whether they came up. A database this
      # image cannot open leaves the API crash-looping, and the operator who
      # just restored it would read `Restored: database` and a zero exit over
      # the top of a control plane that is not answering. The timeout is
      # generous enough for a cold start and short enough that a wedged
      # restore reports rather than hangs.
      if ! "${compose[@]}" up --detach --no-deps --force-recreate --wait --wait-timeout 180 "${running[@]}"; then
        printf 'The control plane did not come back healthy after the restore attempt.\n' >&2
        printf 'Inspect it with: docker compose --file %s logs\n' "${compose_file}" >&2
        cleanup_backup
        exit 1
      fi
    fi
    cleanup_backup
    exit "${status}"
  }
  trap restore_running EXIT
  if [[ -n ${running[0]+x} ]]; then
    "${compose[@]}" stop "${running[@]}"
  fi
  "${run[@]}" -e COMPOSE_RESTORE_OFFLINE=1 blitzecdn-cli "$@"
  publish_configuration
  exit $?
fi

if [[ ${1-} == backup ]]; then
  "${run[@]}" blitzecdn-cli "$@"
else
  exec "${run[@]}" blitzecdn-cli "$@"
fi
