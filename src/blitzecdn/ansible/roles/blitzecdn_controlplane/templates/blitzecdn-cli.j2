#!/usr/bin/env bash
# Managed by BlitzeCDN (blitzecdn_controlplane). Manual edits are lost.
# One-off commands run in a disposable container. Persistent processes are
# started and stopped only through their Compose services.
set -Eeuo pipefail

if [[ ${EUID} -ne 0 ]]; then
  exec sudo --preserve-env=BLITZE_ALLOW_EMPTY_SITES -- "$0" "$@"
fi

readonly compose_file={{ blitzecdn_controlplane_compose_file | quote }}
compose=(docker compose --file "${compose_file}")
run=("${compose[@]}" run --rm)

if [[ -n ${BLITZE_ALLOW_EMPTY_SITES-} ]]; then
  run+=(-e "BLITZE_ALLOW_EMPTY_SITES=${BLITZE_ALLOW_EMPTY_SITES}")
fi

# A database restore must run with every process that can hold the database
# stopped. Preserve the operator's prior running set and restore it on failure.
if [[ ${1-} == backup && ${2-} == restore ]]; then
  running=()
  while IFS= read -r service; do
    case "${service}" in
      blitzecdn-api|blitzecdn-worker) running+=("${service}") ;;
    esac
  done < <("${compose[@]}" ps --status running --services)

  if [[ -n ${running[0]+x} ]]; then
    "${compose[@]}" stop "${running[@]}"
  fi
  restore_running() {
    local status=$?
    if [[ -n ${running[0]+x} ]]; then
      # `--wait`, because `up --detach` returns once the containers have been
      # created and says nothing about whether they came up. A database this
      # image cannot open leaves the API crash-looping, and the operator who
      # just restored it would read `Restored: database` and a zero exit over
      # the top of a control plane that is not answering. The timeout is
      # generous enough for a cold start and short enough that a wedged
      # restore reports rather than hangs.
      if ! "${compose[@]}" up --detach --wait --wait-timeout 180 "${running[@]}"; then
        printf 'The restore completed but the control plane did not come back healthy.\n' >&2
        printf 'Inspect it with: docker compose --file %s logs\n' "${compose_file}" >&2
        exit 1
      fi
    fi
    exit "${status}"
  }
  trap restore_running EXIT
  "${run[@]}" -e COMPOSE_RESTORE_OFFLINE=1 blitzecdn-cli "$@"
  exit $?
fi

exec "${run[@]}" blitzecdn-cli "$@"
