# Managed by BlitzeCDN. Compose installs services; the host SDK runner recovers
# them after restores. Do not start Uvicorn or the worker manually in containers.
#
# Three services and no message broker. Durable work is rows in the control
# plane's own database, so the worker and the API share the state volume rather
# than a queue server — see
# docs/decisions/0008-durable-work-on-the-primary-database.md. What used to be
# here was a fourth service, its own volume, its own healthcheck and a
# `depends_on` from every other service to it.
name: {{ blitzecdn_controlplane_compose_project | to_json }}

x-blitzecdn-runtime: &blitzecdn-runtime
  image: {{ blitzecdn_controlplane_image | to_json }}
  build:
    context: {{ blitzecdn_controlplane_install_dir | to_json }}
    dockerfile: {{ blitzecdn_controlplane_dockerfile | to_json }}
  env_file:
    - {{ (blitzecdn_controlplane_config_dir ~ '/blitzecdn.env') | to_json }}
  environment:
    BLITZE_PROJECT_DIR: /opt/blitzecdn
    BLITZE_CONFIG: /opt/blitzecdn/blitzecdn.toml
  network_mode: host
  volumes:
    - {{ (blitzecdn_controlplane_state_dir ~ ':/opt/blitzecdn/.state') | to_json }}
    - {{ (blitzecdn_controlplane_install_dir ~ '/blitzecdn.toml:/opt/blitzecdn/blitzecdn.toml:ro') | to_json }}
  security_opt:
    - no-new-privileges:true

services:
  blitzecdn-api:
    <<: *blitzecdn-runtime
    container_name: blitzecdn-api
    command: ["python", "-m", "blitzecdn.api"]
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s

  blitzecdn-worker:
    <<: *blitzecdn-runtime
    container_name: blitzecdn-worker
    command: ["python", "-m", "blitzecdn.worker"]
    restart: unless-stopped
    # The worker holds no listener, so liveness is "is the process the image
    # was told to run still the process running". A queue-depth check was
    # considered and rejected: an empty queue is the normal state, and a worker
    # that is merely idle must not be restarted for it.
    healthcheck:
      test: ["CMD", "python", "-c", "import pathlib; raise SystemExit(0 if b'blitzecdn.worker' in pathlib.Path('/proc/1/cmdline').read_bytes() else 1)"]
      interval: 10s
      timeout: 3s
      retries: 6

  blitzecdn-cli:
    <<: *blitzecdn-runtime
    profiles: ["cli"]
    restart: "no"
    volumes:
      - {{ (blitzecdn_controlplane_state_dir ~ ':/opt/blitzecdn/.state') | to_json }}
      - {{ (blitzecdn_controlplane_install_dir ~ '/blitzecdn.toml:/opt/blitzecdn/blitzecdn.toml:ro') | to_json }}
      - {{ (blitzecdn_controlplane_backup_dir ~ ':/var/backups/blitzecdn') | to_json }}
    entrypoint: ["blitzecdn"]
