# Copy to .env, keep mode 0600, and replace this value.
BLITZE_API_KEYS=operator:replace-with-at-least-32-random-characters
BLITZE_INVENTORY=ansible/inventory/hosts.yml
BLITZE_DEPLOYMENT_TIMEOUT_SECONDS=900
BLITZE_DEPLOYMENT_OUTPUT_LIMIT_BYTES=1048576
# Used when a certificate request omits its client-specific email.
BLITZE_ACME_DEFAULT_EMAIL=admin@example.com
# Background first-certificate reconciliation; 0 disables it.
BLITZE_CERTIFICATE_RECONCILE_INTERVAL_SECONDS=600
# Override when certbot is not available on PATH.
BLITZE_CERTBOT=certbot
