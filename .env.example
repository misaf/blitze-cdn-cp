# `blitzecdn setup` writes `.env` with a generated API credential; prefer that
# to copying this file. Left empty, the API refuses to start. To set one by
# hand: BLITZE_API_KEYS=operator:$(openssl rand -hex 32)
BLITZE_API_KEYS=

# GeoLite2 for country rules and the BZ-IPCountry header. The controller
# downloads it once for the whole fleet (see docs/operations.md); edges never
# receive these.
BLITZE_MAXMIND_ACCOUNT_ID=
BLITZE_MAXMIND_LICENSE_KEY=
