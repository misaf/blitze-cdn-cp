# `blitzecdn setup` (or `blitzecdn init`) writes `.env` with a generated API
# credential; prefer that to copying this file. Left empty, the API refuses to
# start. To set one by hand: BLITZE_API_KEYS=operator:$(openssl rand -hex 32)
BLITZE_API_KEYS=

BLITZE_MAXMIND_ACCOUNT_ID=
BLITZE_MAXMIND_LICENSE_KEY=
