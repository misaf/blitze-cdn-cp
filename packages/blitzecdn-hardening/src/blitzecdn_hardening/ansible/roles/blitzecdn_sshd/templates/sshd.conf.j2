## Managed by BlitzeCDN (blitzecdn.edge.blitzecdn_sshd). Manual edits are lost.
##
## sshd takes the FIRST value it sees for a keyword, and /etc/ssh/sshd_config
## begins with `Include /etc/ssh/sshd_config.d/*.conf` on Debian 12 and Ubuntu
## 24.04. This file therefore wins over anything later in the main config. The
## role does not assume that Include survived: after writing this file it reads
## the effective policy back with `sshd -T` and fails if it did not take.

# Public-key authentication is the only accepted method. PasswordAuthentication
# alone is not enough: AuthenticationMethods closes keyboard-interactive and
# any PAM path that could still reach a password prompt.
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
HostbasedAuthentication no
GSSAPIAuthentication no

# Pinned rather than left to the default: the role's pre-flight check proves an
# account can still log in by inspecting authorized_keys ownership and modes,
# and that reasoning is only sound while sshd is actually applying StrictModes.
StrictModes yes

PermitRootLogin {{ blitzecdn_sshd_permit_root_login }}
{% if blitzecdn_sshd_allow_users | length > 0 %}
AllowUsers {{ blitzecdn_sshd_allow_users | join(' ') }}
{% endif %}

# UsePAM stays on for account and session handling (nsswitch, limits, motd).
# With AuthenticationMethods publickey it cannot be used to authenticate.
UsePAM yes

LoginGraceTime {{ blitzecdn_sshd_login_grace_time }}
MaxAuthTries {{ blitzecdn_sshd_max_auth_tries }}
MaxSessions {{ blitzecdn_sshd_max_sessions }}
ClientAliveInterval {{ blitzecdn_sshd_client_alive_interval }}
ClientAliveCountMax {{ blitzecdn_sshd_client_alive_count_max }}

X11Forwarding no
AllowTcpForwarding {{ 'yes' if blitzecdn_sshd_allow_tcp_forwarding else 'no' }}
AllowAgentForwarding {{ 'yes' if blitzecdn_sshd_allow_agent_forwarding else 'no' }}
PermitUserEnvironment no
