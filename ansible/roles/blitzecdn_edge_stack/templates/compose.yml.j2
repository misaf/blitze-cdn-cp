# Managed by BlitzeCDN. Local edits are overwritten.
#
# The whole BlitzeCDN runtime for this edge. Everything above the operating
# system is here; everything the operating system owns — SSH, the firewall,
# sysctl, Docker itself — deliberately is not, so a broken stack still leaves a
# host Ansible can reach and repair.
name: {{ blitzecdn_edge_stack_project }}

services:
  edge:
    container_name: {{ blitzecdn_edge_stack_container }}
    image: {{ blitzecdn_edge_stack_resolved_image }}
    # Host networking, deliberately.
    #
    # A CDN edge listens on thirteen public TCP ports plus UDP/443, and every
    # one of them has to see the visitor's real address: $remote_addr is the
    # source of BZ-Connecting-IP, of the GeoIP2 country lookup, and of every
    # per-site source rule. Behind Docker's bridge and its userland proxy it
    # would be a gateway address instead, and the edge would happily apply a
    # country rule to itself. Host networking also means no NAT hop per packet
    # and no publish list to keep in step with blitzecdn_nginx_http_ports.
    network_mode: host
    restart: unless-stopped
    # Reaps the zombies an Nginx master would otherwise leave behind as PID 1.
    init: true
    stop_grace_period: {{ blitzecdn_edge_stack_stop_grace_period }}
    # Nginx's own signal for "finish what you are doing, then exit". SIGTERM is
    # an immediate shutdown, which turns every container replacement into a
    # burst of visitor errors.
    stop_signal: SIGQUIT
    environment:
      TZ: "{{ blitzecdn_base_timezone | default('UTC') }}"
    volumes:
      # Configuration and TLS material are read-only mounts. The edge has no
      # business rewriting what the control plane rendered, and a container that
      # cannot write its own configuration cannot be talked into persisting a
      # change that the next converge would silently revert.
      - {{ blitzecdn_edge_stack_nginx_config_path }}/conf.d:{{ blitzecdn_edge_stack_nginx_config_path }}/conf.d:ro
      - {{ blitzecdn_edge_stack_nginx_config_path }}/sites-available:{{ blitzecdn_edge_stack_nginx_config_path }}/sites-available:ro
      - {{ blitzecdn_edge_stack_nginx_config_path }}/sites-enabled:{{ blitzecdn_edge_stack_nginx_config_path }}/sites-enabled:ro
      - {{ blitzecdn_edge_stack_module_path }}:{{ blitzecdn_edge_stack_module_path }}:ro
      # Chains and private keys. Read-only, and the host keeps the directory
      # 0700 root with each key 0600 — the container's Nginx master reads them
      # as root at start and at every reload, and nothing else ever needs to.
      - {{ blitzecdn_edge_stack_tls_path }}:{{ blitzecdn_edge_stack_tls_path }}:ro
      # HTTP-01 challenges, written by the acme-challenge playbook on the host
      # and served from here. Read-only for the same reason as the rest.
      - {{ blitzecdn_edge_stack_acme_root }}:{{ blitzecdn_edge_stack_acme_root }}:ro
      # The empty document root Under Attack Mode dispatches through.
      - {{ blitzecdn_edge_stack_empty_root }}:{{ blitzecdn_edge_stack_empty_root }}:ro
{% if blitzecdn_edge_stack_geoip_enabled | bool %}
      # Shared with the geoipupdate service below, which replaces the database
      # in place. Nginx picks the new file up through geoip2's auto_reload
      # without a reload of its own.
      - {{ blitzecdn_edge_stack_geoip_path }}:{{ blitzecdn_edge_stack_geoip_path }}:ro
{% endif %}
      # The two writable mounts, and the only two. Both hold data that must
      # outlive the container: the cache because refilling it from origins after
      # every upgrade is an outage in slow motion, the logs because they are the
      # record of what the edge did — and what Phase 2 monitoring will read.
      - {{ blitzecdn_edge_stack_cache_path }}:{{ blitzecdn_edge_stack_cache_path }}:rw
      - {{ blitzecdn_edge_stack_log_path }}:{{ blitzecdn_edge_stack_log_path }}:rw
    # Container stdout/stderr only — Nginx's request log is the bind-mounted
    # file above and is not affected. Bounded here as well as in daemon.json so
    # the stack carries its own limit onto a host whose engine was configured by
    # someone else.
    logging:
      driver: json-file
      options:
        max-size: "32m"
        max-file: "3"
    # Probe the loopback-only Nginx status endpoint: can this Nginx serve a
    # request right now? Deep deployment checks remain in health.yml. A failing
    # probe marks the container unhealthy; it does not restart it.
    healthcheck:
      test:
        - CMD
        - curl
        - --fail
        - --silent
        - --show-error
        - --max-time
        - "3"
        - --output
        - /dev/null
        - "http://{{ blitzecdn_edge_stack_status_address }}:{{ blitzecdn_edge_stack_status_port }}{{ blitzecdn_edge_stack_status_path }}"
      interval: 30s
      timeout: 5s
      start_period: 20s
      retries: 3

{% if blitzecdn_edge_stack_geoip_enabled | bool %}
  geoipupdate:
    container_name: blitzecdn-geoipupdate
    image: {{ blitzecdn_edge_stack_geoipupdate_image }}
    # Behind a profile, so `docker compose up` never starts it. This is a
    # one-shot: it runs, replaces the database, and exits. The schedule is a
    # systemd timer on the host, which is what gives a fleet a calendar and a
    # randomised delay instead of every edge waking on the same second.
    profiles: [maintenance]
    restart: "no"
    # Default bridge networking, not host: this talks to MaxMind and nothing
    # local, and it has no reason to see the edge's listeners.
    env_file:
      - {{ blitzecdn_edge_stack_geoip_env_file }}
    environment:
      GEOIPUPDATE_EDITION_IDS: "{{ blitzecdn_edge_stack_geoip_edition }}"
      GEOIPUPDATE_DB_DIR: "{{ blitzecdn_edge_stack_geoip_path }}"
      # One shot. The frequency loop is the container's alternative scheduler
      # and would drift a little further from MaxMind's publication window on
      # every converge.
      GEOIPUPDATE_FREQUENCY: "0"
    volumes:
      - {{ blitzecdn_edge_stack_geoip_path }}:{{ blitzecdn_edge_stack_geoip_path }}:rw
{% endif %}
