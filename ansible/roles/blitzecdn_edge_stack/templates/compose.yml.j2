# Managed by BlitzeCDN. Local edits are overwritten.
#
# The whole BlitzeCDN runtime for this edge. Everything above the operating
# system is here; everything the operating system owns — SSH, the firewall,
# sysctl, Docker itself — deliberately is not, so a broken stack still leaves a
# host Ansible can reach and repair.
name: {{ blitzecdn_edge_stack_project }}

services:
  edge:
    container_name: {{ blitzecdn_edge_runtime.container }}
    image: {{ blitzecdn_edge_stack_resolved_image }}
    # Host networking, deliberately.
    #
    # A CDN edge listens on thirteen public TCP ports plus UDP/443, and every
    # one of them has to see the visitor's real address: $remote_addr is the
    # source of BZ-Connecting-IP, of any country lookup a capability installs,
    # and of every
    # per-site source rule. Behind Docker's bridge and its userland proxy it
    # would be a gateway address instead, and the edge would happily apply a
    # country rule to itself. Host networking also means no NAT hop per packet
    # and no publish list to keep in step with the contract's listener sets.
    network_mode: host
    restart: unless-stopped
    # Reaps the zombies an Nginx master would otherwise leave behind as PID 1.
    init: true
    stop_grace_period: {{ blitzecdn_edge_stack_stop_grace_period }}
    # Nginx's own signal for "finish what you are doing, then exit". SIGTERM is
    # an immediate shutdown, which turns every container replacement into a
    # burst of visitor errors.
    stop_signal: SIGQUIT
    environment:
      TZ: "{{ blitzecdn_base_timezone | default('UTC') }}"
    volumes:
      # Configuration and TLS material are read-only mounts. The edge has no
      # business rewriting what the control plane rendered, and a container that
      # cannot write its own configuration cannot be talked into persisting a
      # change that the next converge would silently revert.
      - {{ blitzecdn_edge_runtime.paths.nginx }}/conf.d:{{ blitzecdn_edge_runtime.paths.nginx }}/conf.d:ro
      - {{ blitzecdn_edge_runtime.paths.nginx }}/sites-available:{{ blitzecdn_edge_runtime.paths.nginx }}/sites-available:ro
      - {{ blitzecdn_edge_runtime.paths.nginx }}/sites-enabled:{{ blitzecdn_edge_runtime.paths.nginx }}/sites-enabled:ro
      - {{ blitzecdn_edge_runtime.paths.modules }}:{{ blitzecdn_edge_runtime.paths.modules }}:ro
      # Chains and private keys. Read-only, and the host keeps the directory
      # 0700 root with each key 0600 — the container's Nginx master reads them
      # as root at start and at every reload, and nothing else ever needs to.
      - {{ blitzecdn_edge_runtime.paths.tls }}:{{ blitzecdn_edge_runtime.paths.tls }}:ro
      # HTTP-01 challenges, written by the acme-challenge playbook on the host
      # and served from here. Read-only for the same reason as the rest.
      - {{ blitzecdn_edge_runtime.paths.acme }}:{{ blitzecdn_edge_runtime.paths.acme }}:ro
      # The empty document root Under Attack Mode dispatches through.
      - {{ blitzecdn_edge_runtime.paths.empty }}:{{ blitzecdn_edge_runtime.paths.empty }}:ro
      # Whatever an installed capability provisioned for the edge to read.
      # Always mounted and always read-only: unconditional so the Compose file
      # has one shape in every installation, and read-only because the process
      # that maintains such a file is the capability's, on the host, never the
      # edge. Empty when nothing contributed anything.
      - {{ blitzecdn_edge_runtime.paths.data }}:{{ blitzecdn_edge_runtime.paths.data }}:ro
      # The two writable mounts, and the only two. Both hold data that must
      # outlive the container: the cache because refilling it from origins after
      # every upgrade is an outage in slow motion, the logs because they are the
      # record of what the edge did — and what Phase 2 monitoring will read.
      - {{ blitzecdn_edge_runtime.paths.cache }}:{{ blitzecdn_edge_runtime.paths.cache }}:rw
      - {{ blitzecdn_edge_runtime.paths.logs }}:{{ blitzecdn_edge_runtime.paths.logs }}:rw
    # Container stdout/stderr only — Nginx's request log is the bind-mounted
    # file above and is not affected. Bounded here as well as in daemon.json so
    # the stack carries its own limit onto a host whose engine was configured by
    # someone else.
    logging:
      driver: json-file
      options:
        max-size: "32m"
        max-file: "3"
    # Probe the loopback-only Nginx status endpoint: can this Nginx serve a
    # request right now? Deep deployment checks remain in health.yml. A failing
    # probe marks the container unhealthy; it does not restart it.
    healthcheck:
      test:
        - CMD
        - curl
        - --fail
        - --silent
        - --show-error
        - --max-time
        - "3"
        - --output
        - /dev/null
        - "http://{{ blitzecdn_edge_runtime.status.address }}:{{ blitzecdn_edge_runtime.status.port }}{{ blitzecdn_edge_runtime.status.path }}"
      interval: 30s
      timeout: 5s
      start_period: 20s
      retries: 3

