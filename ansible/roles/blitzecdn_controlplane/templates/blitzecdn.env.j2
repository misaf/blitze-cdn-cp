# Managed by BlitzeCDN (blitzecdn_controlplane) on a first installation only.
# Later runs never rewrite this file; edit it by hand and restart the services.
#
# Read as an EnvironmentFile by the systemd units and sourced by the blitzecdn
# wrapper, so every line must stay a plain NAME=value assignment.
BLITZE_API_KEYS=operator:{{ blitzecdn_controlplane_api_key }}
BLITZE_ACME_DEFAULT_EMAIL={{ blitzecdn_controlplane_acme_email }}
BLITZE_INVENTORY={{ blitzecdn_controlplane_install_dir }}/ansible/inventory/blitzecdn.yml
BLITZE_CERTIFICATE_RECONCILE_INTERVAL_SECONDS={{ blitzecdn_controlplane_certificate_reconcile_seconds }}
BLITZE_PREFLIGHT_DNS_SERVERS={{ blitzecdn_controlplane_preflight_dns_servers }}
