# Created by BlitzeCDN on first installation. Later runs preserve credentials;
# edit them by hand and restart the services after a change.
#
# Read as an EnvironmentFile by the systemd units and sourced by the blitzecdn
# wrapper, so every line must stay a plain NAME=value assignment.
BLITZE_API_KEYS=operator:{{ blitzecdn_controlplane_api_key }}
BLITZE_MAXMIND_ACCOUNT_ID=
BLITZE_MAXMIND_LICENSE_KEY=
