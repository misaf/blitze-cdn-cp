# Created by BlitzeCDN on first installation. Later runs preserve credentials;
# edit them by hand and restart the Compose services after a change.
#
# Read by Docker Compose, so every line must stay a plain NAME=value assignment.
#
# An optional capability's own settings are not seeded here. A capability that
# needs a credential documents its `BLITZE_*` name in its own README, and the
# control plane forwards every `BLITZE_*` variable it does not consume itself
# into the Ansible environment for that capability's role to read. Core seeding
# `BLITZE_MAXMIND_LICENSE_KEY=` on every controller was core carrying the name
# of a package that may not be installed.
BLITZE_API_KEYS=operator:{{ blitzecdn_controlplane_api_key }}
