# Managed by BlitzeCDN. Persistent processes are owned by Compose; do not start
# Uvicorn or Dramatiq manually inside these containers.
x-blitzecdn-runtime: &blitzecdn-runtime
  image: {{ blitzecdn_controlplane_image | to_json }}
  build:
    context: {{ blitzecdn_controlplane_install_dir | to_json }}
    dockerfile: docker/control-plane/Dockerfile
    args:
      BLITZE_UID: {{ blitzecdn_controlplane_service_uid | string | to_json }}
      BLITZE_GID: {{ blitzecdn_controlplane_service_gid | string | to_json }}
  env_file:
    - {{ (blitzecdn_controlplane_config_dir ~ '/blitzecdn.env') | to_json }}
  environment:
    BLITZE_PROJECT_DIR: /opt/blitzecdn
    BLITZE_CONFIG: /opt/blitzecdn/blitzecdn.toml
  network_mode: host
  volumes:
    - {{ (blitzecdn_controlplane_install_dir ~ '/.state:/opt/blitzecdn/.state') | to_json }}
    - {{ (blitzecdn_controlplane_install_dir ~ '/blitzecdn.toml:/opt/blitzecdn/blitzecdn.toml:ro') | to_json }}
    - {{ (blitzecdn_controlplane_service_home ~ '/.ssh:/var/lib/blitzecdn/.ssh:ro') | to_json }}
    - {{ (blitzecdn_controlplane_backup_dir ~ ':/var/backups/blitzecdn') | to_json }}
  security_opt:
    - no-new-privileges:true

services:
  redis:
    image: {{ blitzecdn_controlplane_redis_image | to_json }}
    container_name: blitzecdn-redis
    network_mode: host
    command: ["redis-server", "--bind", "127.0.0.1", "--port", "6379", "--appendonly", "yes"]
    restart: unless-stopped
    volumes:
      - blitzecdn-redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 12

  blitzecdn-api:
    <<: *blitzecdn-runtime
    container_name: blitzecdn-api
    command: ["uvicorn", "blitzecdn.api.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"]
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s

  blitzecdn-worker:
    <<: *blitzecdn-runtime
    container_name: blitzecdn-worker
    command: ["dramatiq", "blitzecdn.worker", "--queues", "deployments", "scheduled", "--processes", "1", "--threads", "2"]
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import pathlib; raise SystemExit(0 if b'dramatiq' in pathlib.Path('/proc/1/cmdline').read_bytes() else 1)"]
      interval: 10s
      timeout: 3s
      retries: 6

  blitzecdn-cli:
    <<: *blitzecdn-runtime
    profiles: ["cli"]
    restart: "no"
    depends_on:
      redis:
        condition: service_healthy
    entrypoint: ["blitzecdn"]

volumes:
  blitzecdn-redis:
    name: blitzecdn-redis

