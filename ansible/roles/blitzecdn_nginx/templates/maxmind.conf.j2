# Managed by BlitzeCDN. Local edits are overwritten.
#
# Credentials for MaxMind's GeoLite2 downloads, read by geoipupdate(8). The
# file is 0600 root-owned and every task touching it sets no_log: the license
# key authenticates to a MaxMind account, it is not a per-database token.
#
# Deliberately not named geoip.conf.j2 — that is the nginx http-context
# template in this same directory, and two files differing only by case cannot
# coexist in a checkout on macOS or Windows.
AccountID {{ blitzecdn_nginx_geoip_account_id }}
LicenseKey {{ blitzecdn_nginx_geoip_license_key }}
EditionIDs {{ blitzecdn_nginx_geoip_edition }}
DatabaseDirectory {{ blitzecdn_nginx_geoip_database | dirname }}
