# Managed by BlitzeCDN. Local edits are overwritten.
#
# nginx's own counters, for whatever scrapes this host. Unauthenticated by
# design — stub_status has no auth of its own — so access is controlled twice
# and independently: the listen address below binds loopback only, and the
# allow/deny list inside the location refuses anything else even if the bind
# address is later widened. Relaxing one without the other is the mistake this
# arrangement exists to survive.
server {
    listen {{ blitzecdn_nginx_status_address }}:{{ blitzecdn_nginx_status_port }};
    server_name _;

    # These requests are ours, not traffic. Logging them would inflate every
    # rate computed from the access log by the scrape interval.
    access_log off;

    location = {{ blitzecdn_nginx_status_path }} {
{% for source in blitzecdn_nginx_status_allow %}
        allow {{ source }};
{% endfor %}
        deny all;
        stub_status;
    }

    # Anything else on this port is not part of the contract. 444 rather than
    # 404 so a probe cannot tell this port apart from a closed one.
    location / {
        return 444;
    }
}
