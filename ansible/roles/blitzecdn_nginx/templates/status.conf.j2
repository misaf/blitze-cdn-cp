# Managed by BlitzeCDN. Local edits are overwritten.
#
# stub_status has no authentication of its own, so access is controlled twice
# and independently: the loopback bind below, and the allow/deny list inside
# the location. Relaxing one without the other exposes the edge's counters.
server {
    listen {{ blitzecdn_edge_runtime.status.address }}:{{ blitzecdn_edge_runtime.status.port }};
    server_name _;

    # Ours, not traffic: logging probes would inflate every rate computed
    # from the access log by the scrape interval.
    access_log off;

    location = {{ blitzecdn_edge_runtime.status.path }} {
{% for source in blitzecdn_nginx_status_allow %}
        allow {{ source }};
{% endfor %}
        deny all;
        stub_status;
    }

    # 444 rather than 404, so a scan cannot tell this port from a closed one.
    location / {
        return 444;
    }
}
