# Managed by BlitzeCDN.
proxy_cache_path {{ blitzecdn_nginx_cache_path }}
    levels=1:2
    keys_zone={{ blitzecdn_nginx_cache_zone }}:{{ blitzecdn_nginx_cache_size }}
    max_size={{ blitzecdn_nginx_cache_max_size }}
    inactive={{ blitzecdn_nginx_cache_inactive }}
    use_temp_path=off;
{% if blitzecdn_nginx_resolvers %}

# Without a resolver, nginx resolves each origin hostname once at config load
# and caches it forever, so traffic keeps going to a stale IP after the origin
# moves. Sites re-resolve on this TTL instead.
resolver {{ blitzecdn_nginx_resolvers | join(' ') }} valid={{ blitzecdn_nginx_resolver_valid }};
resolver_timeout {{ blitzecdn_nginx_resolver_timeout }};
{% endif %}
{% if blitzecdn_nginx_access_log_enabled %}

# The cache outcome per request, which is the number a CDN is measured by.
# $upstream_cache_status is HIT, MISS, EXPIRED, STALE, UPDATING, REVALIDATED or
# BYPASS; it is empty for a request that never consulted the cache, which is
# why it is quoted. $upstream_response_time separates "the origin was slow"
# from "we were slow", the first question asked whenever latency moves.
#
# Defined in the http context here rather than per site so every managed site
# logs the same shape and one parser reads them all.
log_format {{ blitzecdn_nginx_log_format_name }} escape=json
    '$remote_addr $host "$request" $status $body_bytes_sent '
    'rt=$request_time cache="$upstream_cache_status" '
    'upstream="$upstream_addr" ut="$upstream_response_time" '
    'ref="$http_referer" ua="$http_user_agent"';
{% endif %}
{% if blitzecdn_nginx_normalize_accept_encoding %}

# Clients send dozens of distinct Accept-Encoding strings for what are really
# two or three variants. Collapsing them here does two jobs: it becomes part of
# the cache key, so a gzipped and an identity response can no longer collide on
# one entry and be served to the wrong client, and it is what we forward to the
# origin, so the number of variants the origin can produce is bounded by this
# map rather than by client header trivia.
#
# First matching pattern wins, so the preferred encoding is listed first.
map $http_accept_encoding $blitzecdn_accept_encoding {
    default        "";
    "~*(^|,)\s*br\s*(;|,|$)"    "br";
    "~*(^|,)\s*gzip\s*(;|,|$)"  "gzip";
}
{% endif %}
