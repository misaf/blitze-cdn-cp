[Unit]
Description=Check BlitzeCDN edges for configuration drift every hour

[Timer]
# Hourly. A drift check is a full check-mode convergence across the fleet, so
# it is not free; hourly bounds how long an edge can sit changed before anyone
# knows without making the fleet spend its life being checked.
OnCalendar=hourly
RandomizedDelaySec=600
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
